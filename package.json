{
  "name": "crowd-coin",
  "version": "2.0.0",
  "private": true,
  "description": "Modernized Ethereum crowdfunding dApp built with Next.js, ethers and Hardhat",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "ethers": "^6.13.5",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "license": "ISC"
}
