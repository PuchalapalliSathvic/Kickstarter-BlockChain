# Browser/server read RPC. For local Hardhat use http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Filled automatically by npm run deploy:local or deploy:sepolia
NEXT_PUBLIC_FACTORY_ADDRESS=

# Only required for Sepolia deployment. Never commit a real private key.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
